---
import { Image } from "astro:assets";
import Macchu_picchu from "../assets/Machu_Picchu.jpg";
import Nazca from "../assets/Lineas_Nazca.avif";
import Mancora from "../assets/Mancora.jpg";
import { Icon } from "astro-icon/components";
const destacados = [
  {
    title: "Machu Picchu",
    slogan: "El reencuentro con tu alma en la cima del mundo",
    descripcion:
      "Machu Picchu es una ciudadela inca ubicada en las alturas de las montañas de los Andes en Perú, sobre el valle del río Urubamba.",
    imagen: Macchu_picchu,
  },
  {
    title: "Líneas de Nazca",
    slogan: "Un misterio grabado en la arena que solo el cielo puede explicar",
    descripcion:
      "Las Líneas de Nazca, en el sur de Perú, son un grupo de geoglifos precolombinos que se extienden en las arenas del desierto.",
    imagen: Nazca,
  },
  {
    title: "Máncora",
    slogan: "Tu verano infinito frente al Pacífico",
    descripcion:
      "Máncora es una ciudad turística en la región Piura, en la costa noroeste de Perú. Es conocida por su playa de arena Máncora, cuyas grandes olas atraen a los surfistas. Las playas Pocitas y Vichayito son más tranquilas. La calle principal, Avenida Piura, está repleta de restaurantes y cafés. Los bares de la ciudad dan lugar a una animada vida nocturna.",
    imagen: Mancora,
  },
];
---

<section>
  <h2>Destinos destacados</h2>
  <article>
    <div class="img-pass">
      {
        destacados.map((destacado) => (
          <Image
            src={destacado.imagen}
            alt={destacado.title}
            id={destacado.title}
            data-title={destacado.title}
            data-slogan={destacado.slogan}
            data-descripcion={destacado.descripcion}
            class="img-destacado"
          />
        ))
      }
    </div>
    <div>
      {
        (
          <div class="img-select">
            <Image
              src={destacados[0].imagen}
              alt={destacados[0].title}
              class="as"
            />
            <h3 class="titulo">{destacados[0].title}</h3>
            <p class="slogan">{destacados[0].slogan}</p>
            <p class="descripcion">{destacados[0].descripcion}</p>
            <a class="mas" href="#">
              Explora mas <Icon name="ant-design:arrow-right-outlined" />
            </a>
          </div>
        )
      }
    </div>
  </article>
</section>

<script>
  let imagenBase = document.querySelectorAll(".img-destacado");
  let titulo = document.querySelector(".titulo");
  let slogan = document.querySelector(".slogan");
  let descripcion = document.querySelector(".descripcion");
  let imagen = document.querySelector(".as");

  imagenBase.forEach((miniatura) => {
    miniatura.addEventListener("click", (evento) => {
      const nuevoSrc = evento.currentTarget.src;
      const nuevoTitle = evento.currentTarget.dataset.title;
      const nuevoSlogan = evento.currentTarget.dataset.slogan;
      const nuevaDesc = evento.currentTarget.dataset.descripcion;

      imagen.classList.add("fade-out");
      titulo.classList.add("fade-out");
      slogan.classList.add("fade-out");
      descripcion.classList.add("fade-out");

      setTimeout(() => {
        imagen.src = nuevoSrc;
        titulo.textContent = nuevoTitle;
        slogan.textContent = nuevoSlogan;
        descripcion.textContent = nuevaDesc;

        imagen.classList.remove("fade-out");
        titulo.classList.remove("fade-out");
        slogan.classList.remove("fade-out");
        descripcion.classList.remove("fade-out");
      }, 300);
    });
  });
</script>

<style>
  *,
  ::after ::before {
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
  }
  .img-pass {
    width: 100vw;
    display: flex;
    justify-content: center;
  }
  .fade-out {
    opacity: 0;
  }
  .img-destacado {
    margin: 0px 5px;
    display: block;
    width: 29.5vw;
    height: 12vh;
    border-radius: 15px;
    cursor: pointer;
  }
  h2 {
    color: #d9b57f;
    font-size: 1.2rem;
    text-align: center;
    margin-bottom: 20px;
  }
  
  .slogan,
  .titulo,
  .descripcion {
    transition: opacity 0.3s ease-in-out;
  }

  .titulo {
    font-size: 2.2rem;
    margin: 10px 0px;
    text-align: center;
  }
  .slogan {
    color: gray;
    margin: 10px 0px;
    text-align: center;
    font-size: 1.2rem;
  }

  .descripcion {
    margin: 0px;
    text-align: justify;
    font-size: 1.4rem;
  }
  .img-select {
    width: 94vw;
    height: auto;
    margin: 15px auto;
    border-radius: 15px;
    color: white;

  }
  .img-select .as {
    object-fit: cover;
    width: 100%;
    height: 30vh;
    border-radius: 15px;
    transition: opacity 0.3s ease-in-out;
  }
  .mas {
    padding: 10px 15px;
    background-color: transparent;
    color: #d9b57f;
    border: solid 1px #d9b57f;
    border-radius: 15px;
    text-decoration: none;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 120px;
    gap: 10px;
    text-align: center;
    margin: 10px auto;
  }
</style>
