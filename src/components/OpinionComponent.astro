---
import { Icon } from "astro-icon/components";

const { message, name, year } = Astro.props;
---

<div class="card">
  <div class="message"><q>{message}</q></div>
  <div class="card-info">
    <div>
      <Icon  class="icono" name="ant-design:user-outlined" />
    </div>
    <div class="usuario"><span><p>{name}</p><p class="tiempo">{year}</p></span></div>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: 100%;
    scroll-snap-align: start;
  }
  .message {
    text-align: center;
    font-size:1.3rem;
  }
  .icono{
    width: 50px;
    height: 50px;
    border:3px solid white;
    border-radius: 50%;
  }
  .tiempo{
    font-size:0.9rem;
  }
  .usuario *{
    margin: 0px;
    padding: 0px;
  }
  .card-info{
    margin: 10px 0px;
    display: flex;
    justify-content: center;
    gap: 15px;
    align-items: center;
  }
  .usuario {
    display: flex;
    flex-direction: column;
    font-size: 1.2rem;
  }
</style>
